{
  "name": "pwvault",
  "version": "2.0.0",
  "description": "Offline encrypted password vault",
  "scripts": {
    "dev": "vite",
    "build:single": "vite build --mode single",
    "build:pwa": "vite build --mode pwa",
    "build": "npm run build:single && npm run build:pwa",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "e2e": "playwright test"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@wordlist/english-eff": "^1.0.1",
    "diceware-wordlist-en-eff": "^1.0.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.1"
  },
  "private": true,
  "type": "module"
}
